# Copy to `trust-center/.env.local` (gitignored) and set:
#
#   VITE_LOGO_DEV_TOKEN=pk_…your_publishable_key…
#
# Use the Publishable key (pk_) from https://www.logo.dev/dashboard/api-keys — not the Secret (sk_) key.
# If logos never load and the browser console shows “invalid api token”, regenerate or recopy the pk_ key.
# After changing this file, restart: Ctrl+C then `npm run dev` from the `trust-center` folder.

VITE_LOGO_DEV_TOKEN=

